Response Content: {"total": 4, "offset": 0, "data": [{"paperId": "196a0e4b7d4dc227ccf93582548438b0880745a7", "title": "Neural Dynamics of Perceptual Detection Under Temporal Uncertainty", "venue": "", "year": 2015, "citationCount": 1, "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: The following paper fields have been elided by the publisher: {'abstract'}. Paper or abstract available at https://www.cs.bgu.ac.il/~frankel/Brain%20Information%20and%20Coding%20Day%20Seminar/Brain%
