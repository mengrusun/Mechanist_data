Response Content: {"total": 1, "offset": 0, "data": [{"paperId": "b82a780a87563040f7dab6484ece0f744d52324c", "title": "Modeling Parallelization in Skill Acquisition 1 Running Head : MODELING PARALLELIZATION IN SKILL ACQUISITION Modeling parallelization and speed improvement in skill acquisition : from dual tasks to complex dynamic skills", "venue": "", "year": 2004, "citationCount": 13, "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: The following paper fields have been elided
