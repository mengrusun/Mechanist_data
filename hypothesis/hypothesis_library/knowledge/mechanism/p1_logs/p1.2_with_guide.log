Response Content: {"total": 2, "offset": 0, "data": [{"paperId": "fed5984b2993bbbba6adfda05a921a8e26b1e825", "title": "DecoPrompt : Decoding Prompts Reduces Hallucinations when Large Language Models Meet False Premises", "venue": "arXiv.org", "year": 2024, "citationCount": 5, "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: Paper or abstract available at https://arxiv.org/abs/2411.07457, which is subject to the license by the author or copyright owner provided with this content
