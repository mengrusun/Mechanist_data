Response Content: {"total": 6, "offset": 0, "next": 5, "data": [{"paperId": "1fc74a68c6eca67c83f3281222a5413da21e1fe8", "title": "Functional Theory of Mind Evaluation in Large Language Models: A Behavioral and Causal Stability Framework", "venue": "International Scientific Journal of Engineering and Management", "year": 2026, "citationCount": 0, "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: Paper or abstract available at https://api.unpaywall.org/v2/10.55041/isjem05948?email
