Response Content: {"total": 34, "offset": 0, "next": 5, "data": [{"paperId": "7d69b1d3ce8d2ff86b7899c4834656c0926a7b1e", "title": "Multi-Perspective Protein Representation Learning for Protein-Protein Interaction Prediction", "venue": "IEEE International Joint Conference on Neural Network", "year": 2025, "citationCount": 0, "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: Paper or abstract available at https://api.unpaywall.org/v2/10.1109/IJCNN64981.2025.11227972?email=<INSERT_
