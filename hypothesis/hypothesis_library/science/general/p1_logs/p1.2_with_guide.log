Response Content: {"total": 63, "offset": 0, "next": 5, "data": [{"paperId": "6337405a128278ac9f9020636fd80426be409498", "title": "Universal Extraction of Quantum Critical Exponents and Phase Transitions via Tailored Hilbert Space", "venue": "", "year": 2026, "citationCount": 0, "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: Paper or abstract available at https://arxiv.org/abs/2606.24312, which is subject to the license by the author or copyright owner provided with this cont
