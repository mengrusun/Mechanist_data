Response Content: {"total": 2, "offset": 0, "data": [{"paperId": "e0b8fcb8a435cb8f1ada25a33a13cc8f96ca772f", "title": "EXACT: an explainable anomaly-aware vision foundation model for analysis of 3D chest CT", "venue": "arXiv.org", "year": 2026, "citationCount": 3, "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: Paper or abstract available at https://arxiv.org/abs/2604.24146, which is subject to the license by the author or copyright owner provided with this content. Please go 
