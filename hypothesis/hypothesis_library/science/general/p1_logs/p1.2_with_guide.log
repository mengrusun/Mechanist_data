Response Content: {"total": 69, "offset": 0, "next": 5, "data": [{"paperId": "c5afbd17b27bd912c714945aa6fb7acf779b6331", "title": "Accelerating protein engineering: an integrated framework combines protein language models and epistatic landscape modeling", "venue": "Signal Transduction and Targeted Therapy", "year": 2026, "citationCount": 0, "openAccessPdf": {"url": "https://www.nature.com/articles/s41392-026-02944-6.pdf", "status": "GOLD", "license": "CCBYNCND", "disclaimer": "Notice: Paper or abstract available
