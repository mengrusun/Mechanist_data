Response Content: {"total": 204, "offset": 0, "next": 5, "data": [{"paperId": "4eb944cab254958229118392616afd2a040433bc", "title": "BrainOmni: A Brain Foundation Model for Unified EEG and MEG Signals", "venue": "Neural Information Processing Systems", "year": 2025, "citationCount": 30, "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: Paper or abstract available at https://arxiv.org/abs/2505.18185, which is subject to the license by the author or copyright owner provided with th
