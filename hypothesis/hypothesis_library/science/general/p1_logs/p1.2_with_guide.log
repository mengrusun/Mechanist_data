Response Content: {"total": 27, "offset": 0, "next": 5, "data": [{"paperId": "d6404f74b7738ada4043be922e2c93144f3fb37c", "title": "Forcing, feedback and internal variability in global temperature trends", "venue": "Nature", "year": 2015, "citationCount": 198, "openAccessPdf": {"url": "https://eprints.whiterose.ac.uk/83143/1/Marotzke_Forster_Rev2_online.pdf", "status": "GREEN", "license": null, "disclaimer": "Notice: The following paper fields have been elided by the publisher: {'abstract'}. Paper or abstract avai
