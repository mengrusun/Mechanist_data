Response Content: {"total": 37, "offset": 0, "next": 5, "data": [{"paperId": "30eed9bc32717dfa4d199007836500a145918a41", "title": "Conceptual model for millennial climate variability: a possible combined solar-thermohaline circulation origin for the ~1,500-year cycle", "venue": "", "year": 2009, "citationCount": 57, "openAccessPdf": {"url": "", "status": "CLOSED", "license": null, "disclaimer": "Notice: The following paper fields have been elided by the publisher: {'abstract'}. Paper or abstract available at http
