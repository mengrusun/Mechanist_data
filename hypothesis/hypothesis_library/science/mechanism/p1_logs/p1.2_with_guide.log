Response Content: {"total": 8, "offset": 0, "next": 5, "data": [{"paperId": "345e3f74e746077816223c42c9041f5de30cbf3e", "title": "MEGA 5 : Molecular Evolutionary Genetics Analysis using Maximum Likelihood , Evolutionary Distance , and Maximum Parsimony Methods", "venue": "", "year": 2011, "citationCount": 2577, "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: The following paper fields have been elided by the publisher: {'abstract'}. Paper or abstract available at http://php.sc
