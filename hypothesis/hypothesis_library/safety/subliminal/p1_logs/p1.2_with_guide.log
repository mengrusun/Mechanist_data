Response Content: {"total": 1, "offset": 0, "data": [{"paperId": "537299226ed3489d586748161488fd3f6c829805", "title": "Quantum Subliminal Learning", "venue": "", "year": 2026, "citationCount": 1, "openAccessPdf": {"url": "", "status": null, "license": null, "disclaimer": "Notice: Paper or abstract available at https://arxiv.org/abs/2605.29557, which is subject to the license by the author or copyright owner provided with this content. Please go to the source to verify the license and copyright information for you
